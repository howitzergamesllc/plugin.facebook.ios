<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net11.0-ios; net11.0-maccatalyst</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <IsBindingProject>true</IsBindingProject>
    <NoBindingEmbedding>true</NoBindingEmbedding>
    <SupportedOSPlatformVersion>16.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
    <RootNamespace>Facebook.Login</RootNamespace>
    <AssemblyName>Facebook.Login</AssemblyName>
    <AssemblyVersion>11.0.0.0</AssemblyVersion>
    <FileVersion>11.0.0.0</FileVersion>
    <IPhoneResourcePrefix>Resources</IPhoneResourcePrefix>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageVersion>11.0.0-local</PackageVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PackageVersion>11.0.0.0</PackageVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>plugin.Facebook.iOS.Login</PackageId>
    <Title>Facebook LoginKit API iOS Library</Title>
    <Summary>C# bindings for Facebook LoginKit API iOS Library</Summary>
    <Description>C# bindings for Facebook LoginKit API iOS Library</Description>
		<PackageTags>MAUI iOS Facebook</PackageTags>
		<Authors>Howitzer Games</Authors>
		<Owners>Howitzer Games</Owners>
		<Copyright>© Microsoft Corporation. All rights reserved. © 2026 Howitzer Games. All Rights Reserved</Copyright>
    <PackageProjectUrl>https://github.com/howitzergamesllc/plugin.facebook.ios</PackageProjectUrl>
    <PackageLicenseFile>License.md</PackageLicenseFile>
		<PackageReadmeFile>Readme.md</PackageReadmeFile>
		<NeutralLanguage>en</NeutralLanguage>
		<PackageIcon>Icon.png</PackageIcon>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <RepositoryUrl>https://github.com/howitzergamesllc/plugin.facebook.ios</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackOnBuild>true</PackOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Resources\" />
  </ItemGroup>

	<ItemGroup>
		<None Include="..\..\art\Icon.png" Pack="True" PackagePath="Icon.png" />
		<None Include="..\..\License.md" Pack="True" PackagePath="License.md" />
		<None Include="..\..\Readme.md" Pack="True" PackagePath="Readme.md"/>
		<None Include="..\..\External-Dependency-Info.txt" Pack="True" PackagePath="THIRD-PARTY-NOTICES.txt" />
	</ItemGroup>
  
  <ItemGroup>
    <None Include="sharpie\ApiDefinitionsRaw.md" Pack="False"/>
    <None Include="sharpie\StructsAndEnumsRaw.md" Pack="False"/>
    <None Include="sharpie\ApiDefinitionsRawSwift.md" Pack="False"/>
    <None Include="sharpie\EnumsSwiftRaw.md" Pack="False"/>
  </ItemGroup>

  <ItemGroup>
    <NativeReference Include="..\..\externals\FBSDKLoginKit.xcframework">
      <Kind>Framework</Kind>
      <SmartLink>True</SmartLink>
      <ForceLoad>True</ForceLoad>
      <LinkerFlags>-ObjC</LinkerFlags>
      <Frameworks>UIKit Foundation CoreGraphics AuthenticationServices Security CryptoKit</Frameworks>
    </NativeReference>
  </ItemGroup>

  <ItemGroup>
    <ObjcBindingCoreSource Include="Enums.cs" />
  </ItemGroup>
  <ItemGroup>
    <ObjcBindingApiDefinition Include="ApiDefinitions.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" PrivateAssets="None" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Xamarin.Build.Download" Version="0.11.6" PrivateAssets="None" />
  </ItemGroup>
</Project>
