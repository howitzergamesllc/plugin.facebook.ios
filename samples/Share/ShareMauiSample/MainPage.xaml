<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:facebook="clr-namespace:ShareMauiSample.FacebookControls"
             x:Class="ShareMauiSample.MainPage">

    <ScrollView>
        <VerticalStackLayout
            x:Name="layout"
            Padding="30,0"
            Spacing="25">
            <Image
                x:Name="dotnetbotImage"
                Source="dotnet_bot.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="dot net bot in a submarine number ten" />
            <Label
                Text="Facebook SDKs"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />
            <Label
                Text="ShareMauiSample"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2" />

            <Label
                Text="Shares an image in memory asset."
                Style="{StaticResource SubHeadline}"
                FontSize="11"
                SemanticProperties.HeadingLevel="Level3" />
            <facebook:ShareButton
                x:Name="ImageMemoryShareBtn"/>
                
            <Label
                Text="Shares an image from a Uri."
                Style="{StaticResource SubHeadline}"
                FontSize="11"
                SemanticProperties.HeadingLevel="Level3" />
            <facebook:ShareButton
                x:Name="ImageUriShareBtn" />
                
            <Label
                Text="Sends an image from a Uri."
                Style="{StaticResource SubHeadline}"
                FontSize="11"
                SemanticProperties.HeadingLevel="Level3" />
            <facebook:SendButton
                x:Name="ImageSendBtn"/>

            <Label
                Text="Shares an image in memory asset."
                Style="{StaticResource SubHeadline}"
                FontSize="11"
                SemanticProperties.HeadingLevel="Level3" />
            <Button
                x:Name="ManualImageShareBtn"
                Text="ManualImageShareBtn"
                Pressed="HandleManualMemoryImageShareTouch"/>

            <Label
                Text="Shares a video in memory asset."
                Style="{StaticResource SubHeadline}"
                FontSize="11"
                SemanticProperties.HeadingLevel="Level3" />
            <Button
                x:Name="ManualVideoShareBtn"
                Text="ManualVideoShareBtn"
                Pressed="HandleManualMemoryVideoShareTouch"/>

            <Label
                Text="Sends an image from a Uri."
                Style="{StaticResource SubHeadline}"
                FontSize="11"
                SemanticProperties.HeadingLevel="Level3" />
            <Button
                x:Name="ManualImageSendBtn"
                Text="ManualSendBtn"
                Pressed="HandleManualSendTouch"/>

            <Label
                Text="Shares an in memory video."
                Style="{StaticResource SubHeadline}"
                FontSize="11"
                SemanticProperties.HeadingLevel="Level3" />
            <facebook:ShareButton
                x:Name="VideoMemoryShareBtn"/>

            <Label
                Text="Shares a video from a Uri."
                Style="{StaticResource SubHeadline}"
                FontSize="11"
                SemanticProperties.HeadingLevel="Level3" />
            <facebook:ShareButton
                x:Name="VideoUriShareBtn"/>

            <Label
                Text="Sends a video from a Uri."
                Style="{StaticResource SubHeadline}"
                FontSize="11"
                SemanticProperties.HeadingLevel="Level3" />
            <facebook:SendButton
                x:Name="VideoSendBtn"/>
                
            <Label
                Text="Shares an app store page from a Uri."
                Style="{StaticResource SubHeadline}"
                FontSize="11"
                SemanticProperties.HeadingLevel="Level3" />
            <facebook:ShareButton
                x:Name="AppShareBtn"/>

            <Label
                Text="Sends an app store page from a Uri."
                Style="{StaticResource SubHeadline}"
                FontSize="11"
                SemanticProperties.HeadingLevel="Level3" />
            <facebook:SendButton
                x:Name="AppSendBtn"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
